# Firebase console -> Project settings -> General -> Your apps -> Web app (SDK setup and configuration)
# VITE_ vars are inlined into the JS bundle at build time - fine for these
# values, which Firebase's own security model treats as public (access is
# enforced by Security Rules / App Check, not by hiding them).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The backend API's base URL. Defaults to http://localhost:8080 if unset.
VITE_API_BASE_URL=http://localhost:8080
