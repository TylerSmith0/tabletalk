# Firebase Admin SDK credentials - set ONE of the two options below.
# Firebase console -> Project settings -> Service accounts -> Generate new private key

# Option A: paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: path to the downloaded service account JSON file instead
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=8080

# Origin the browser-based admin console is served from, for CORS.
# Defaults to Vite's dev server origin if unset.
ALLOWED_ORIGIN=http://localhost:5173
