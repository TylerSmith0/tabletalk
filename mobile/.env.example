# Firebase console -> Project settings -> General -> Your apps -> Web app (SDK setup and configuration)
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time - fine for
# these values, which Firebase's own security model treats as public
# (access is enforced by Security Rules / App Check, not by hiding them).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
